# Environment Configuration for Procurement AI Agent System
# Email Configuration
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_ADDRESS=test@gmail.com
EMAIL_PASSWORD=test_password

# Database
DATABASE_PATH=data/vendors.db

# OpenAI Configuration (for future LLM integration)
OPENAI_API_KEY=sk-test-key

# Anthropic Configuration (alternative LLM)
ANTHROPIC_API_KEY=test-api-key

# Procurement Settings
MIN_VENDOR_RATING=3.0
MAX_DELIVERY_DAYS=30
IDEAL_DELIVERY_DAYS=7

# Business Rules
MAX_ORDER_VALUE=50000
AUTO_APPROVE_THRESHOLD=10000
APPROVE_DISCOUNT_THRESHOLD=5000

# Notification Settings
NOTIFY_ON_DELIVERY_DELAY=true
NOTIFY_ON_QUALITY_ISSUE=true
ESCALATION_EMAIL=manager@company.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/procurement_agent.log

# Agent Intervals (in seconds)
EMAIL_CHECK_INTERVAL=300
RFQ_MONITOR_INTERVAL=60
ORDER_MONITOR_INTERVAL=300
FOLLOWUP_PROCESS_INTERVAL=3600
